target: .
output_dir: ./reports

scanners: [semgrep, gitleaks, trivy, checkov, zap]
formats: [json, html, sarif, md, csv]

fail_on: [CRITICAL, HIGH]
fail_on_new_only: false
fail_on_secrets: true

baseline: .secagent-baseline.json
suppressions: .secagent-suppressions.yml

parallelism: 4

trivy:
  timeout_seconds: 300
  cache_dir: ./.secagent-work/trivy-cache

zap:
  enabled: false
  target_url: http://127.0.0.1:3000
  api_url: http://127.0.0.1:8080
  api_request_timeout_seconds: 20
  api_retries: 5
  api_retry_delay_seconds: 1.0
  timeout_seconds: 300

runtime:
  allow_partial_results: false
