<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SecAgent Security Report</title>
  <style>
    :root {
      --bg: #f3f7fb;
      --panel: #ffffff;
      --text: #14212f;
      --muted: #5c7088;
      --line: #d7e2ee;
      --brand: #0069c2;
      --pass: #0f7b6c;
      --fail: #b4232c;
      --critical: #8f1616;
      --high: #cc3d00;
      --medium: #c27a00;
      --low: #1f6f2f;
      --info: #0f5f8f;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "IBM Plex Sans", "Noto Sans", "Segoe UI", sans-serif;
      color: var(--text);
      background: radial-gradient(circle at 10% 10%, #e9f3ff 0%, #f8fbff 35%, #f2f6fb 100%);
    }
    .wrap { max-width: 1240px; margin: 0 auto; padding: 24px; }
    .hero {
      background: linear-gradient(120deg, #d9ebff 0%, #e9f4ff 45%, #f7fbff 100%);
      border: 1px solid #c7dcf3;
      border-radius: 14px;
      padding: 18px 20px;
      margin-bottom: 16px;
    }
    .title { margin: 0; font-size: 1.6rem; }
    .meta { color: var(--muted); margin-top: 8px; font-size: 0.95rem; }
    .cards { display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: 10px; margin-bottom: 14px; }
    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px 12px;
      box-shadow: 0 1px 0 rgba(17, 34, 51, 0.02);
    }
    .card .k { color: var(--muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .card .v { font-size: 1.25rem; margin-top: 2px; font-weight: 700; }
    .policy-pass { color: var(--pass); }
    .policy-fail { color: var(--fail); }
    .toolbar {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 10px;
      margin: 12px 0;
    }
    input, select {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 9px 10px;
      font-size: 0.92rem;
      background: #fff;
      color: var(--text);
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 14px;
    }
    .panel h2 {
      margin: 0;
      font-size: 1rem;
      padding: 11px 14px;
      border-bottom: 1px solid var(--line);
      background: #f9fcff;
    }
    table { width: 100%; border-collapse: collapse; }
    th, td {
      text-align: left;
      padding: 9px 10px;
      border-bottom: 1px solid #edf2f7;
      font-size: 0.88rem;
      vertical-align: top;
    }
    th { background: #f8fbff; color: #34495f; font-weight: 700; }
    .badge {
      display: inline-block;
      font-size: 0.75rem;
      border-radius: 999px;
      padding: 3px 8px;
      border: 1px solid var(--line);
      white-space: nowrap;
    }
    .sev-CRITICAL { background: #ffe7e7; color: var(--critical); border-color: #ffc8c8; }
    .sev-HIGH { background: #fff0e4; color: var(--high); border-color: #ffd8bd; }
    .sev-MEDIUM { background: #fff8e0; color: var(--medium); border-color: #f3e1ab; }
    .sev-LOW { background: #e9f9ec; color: var(--low); border-color: #c6ebd0; }
    .sev-INFO { background: #e9f5ff; color: var(--info); border-color: #cfe6fb; }
    .sev-UNKNOWN { background: #f0f3f7; color: #5f6f80; border-color: #d6dee6; }
    .small { color: var(--muted); font-size: 0.82rem; }
    .hidden { display: none; }
    @media (max-width: 980px) {
      .cards { grid-template-columns: repeat(3, minmax(0,1fr)); }
      .toolbar { grid-template-columns: 1fr; }
      th:nth-child(6), td:nth-child(6) { display: none; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <section class="hero">
      <h1 class="title">SecAgent Security Report</h1>
      <div class="meta">Target: <strong>{{ report.metadata.target }}</strong> | Generated: {{ report.metadata.generated_at }} | Profile: {{ report.metadata.profile }}</div>
    </section>

    <section class="cards">
      <div class="card"><div class="k">Total</div><div class="v">{{ report.summary.total }}</div></div>
      <div class="card"><div class="k">Critical</div><div class="v">{{ report.summary.by_severity.get('CRITICAL', 0) }}</div></div>
      <div class="card"><div class="k">High</div><div class="v">{{ report.summary.by_severity.get('HIGH', 0) }}</div></div>
      <div class="card"><div class="k">Medium</div><div class="v">{{ report.summary.by_severity.get('MEDIUM', 0) }}</div></div>
      <div class="card"><div class="k">Low</div><div class="v">{{ report.summary.by_severity.get('LOW', 0) }}</div></div>
      <div class="card"><div class="k">Policy</div><div class="v {{ 'policy-pass' if report.policy.passed else 'policy-fail' }}">{{ 'PASS' if report.policy.passed else 'FAIL' }}</div></div>
    </section>

    <section class="panel">
      <h2>Policy Evaluation</h2>
      <div style="padding:10px 14px;">
        {% if report.policy.reasons %}
          <ul style="margin:0 0 4px 18px;">
            {% for reason in report.policy.reasons %}<li>{{ reason }}</li>{% endfor %}
          </ul>
        {% else %}
          <div class="small">No policy violations detected.</div>
        {% endif %}
      </div>
    </section>

    <section class="toolbar">
      <input id="q" placeholder="Search findings (title, path, tool, fingerprint)" />
      <select id="sev"><option value="">All severities</option><option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option><option>INFO</option><option>UNKNOWN</option></select>
      <select id="tool"><option value="">All tools</option>{% for name in report.summary.by_scanner.keys()|sort %}<option>{{ name }}</option>{% endfor %}</select>
      <select id="status"><option value="">All status</option><option>new</option><option>baselined</option><option>suppressed</option><option>active</option><option>unchanged</option></select>
    </section>

    <section class="panel">
      <h2>Findings (<span id="visible-count">{{ report.findings|length }}</span> shown)</h2>
      <table id="findings-table">
        <thead>
          <tr><th>Severity</th><th>Title</th><th>Tool</th><th>Location</th><th>Status</th><th>Fingerprint</th></tr>
        </thead>
        <tbody>
          {% for f in report.findings %}
          <tr data-sev="{{ f.severity.value }}" data-tool="{{ f.tool }}" data-status="{{ f.status.value }}" data-search="{{ (f.title ~ ' ' ~ (f.file_path or f.resource or '') ~ ' ' ~ f.tool ~ ' ' ~ f.fingerprint)|lower }}">
            <td><span class="badge sev-{{ f.severity.value }}">{{ f.severity.value }}</span></td>
            <td>
              <div>{{ f.title }}</div>
              {% if f.description %}<div class="small">{{ f.description }}</div>{% endif %}
            </td>
            <td>{{ f.tool }}</td>
            <td>{{ f.file_path or f.resource or '-' }}{% if f.line_start %}:{{ f.line_start }}{% endif %}</td>
            <td>{{ f.status.value }}</td>
            <td class="small">{{ f.fingerprint }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div id="empty" class="hidden" style="padding: 12px 14px;" >No findings match the current filters.</div>
    </section>

    <section class="panel">
      <h2>Scanner Execution</h2>
      <table>
        <thead>
          <tr><th>Scanner</th><th>Status</th><th>Duration(s)</th><th>Return</th><th>Command</th></tr>
        </thead>
        <tbody>
        {% for s in report.scanner_runs %}
        <tr>
          <td>{{ s.scanner }}</td>
          <td>{{ s.status }}</td>
          <td>{{ '%.2f'|format(s.duration_seconds) }}</td>
          <td>{{ s.return_code if s.return_code is not none else '-' }}</td>
          <td class="small">{{ s.command }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
    </section>
  </div>

  <script>
    const table = document.getElementById('findings-table');
    const rows = Array.from(table.querySelectorAll('tbody tr'));
    const q = document.getElementById('q');
    const sev = document.getElementById('sev');
    const tool = document.getElementById('tool');
    const status = document.getElementById('status');
    const visibleCount = document.getElementById('visible-count');
    const empty = document.getElementById('empty');

    function applyFilters() {
      const term = q.value.trim().toLowerCase();
      let shown = 0;

      rows.forEach((row) => {
        const matchesSearch = !term || row.dataset.search.includes(term);
        const matchesSev = !sev.value || row.dataset.sev === sev.value;
        const matchesTool = !tool.value || row.dataset.tool === tool.value;
        const matchesStatus = !status.value || row.dataset.status === status.value;
        const show = matchesSearch && matchesSev && matchesTool && matchesStatus;
        row.classList.toggle('hidden', !show);
        if (show) shown += 1;
      });

      visibleCount.textContent = String(shown);
      empty.classList.toggle('hidden', shown !== 0);
    }

    [q, sev, tool, status].forEach((el) => el.addEventListener('input', applyFilters));
    applyFilters();
  </script>
</body>
</html>
